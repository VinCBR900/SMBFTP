--- a/include/bdsm/smb_session.h
+++ b/include/bdsm/smb_session.h
@@ -166,5 +166,22 @@ int             smb_session_supports(smb_session *s, int what);
 BDSM_EXPORT
 uint32_t        smb_session_get_nt_status(smb_session *s);
 
+/**
+ * @brief How did the last smb_find() end ?
+ * @details Added by the smbftp port. smb_find() keeps the entries it could read
+ * even when the listing could not be completed; this tells the caller whether
+ * that happened. The value is reset at the start of every smb_find().
+ *
+ * @param s The session object
+ * @return A bit mask: 0 = listing complete and well formed;
+ * SMB_FIND_INCOMPLETE = entries may be missing (network failure, malformed or
+ * cut-short reply); SMB_FIND_RESYNCED = the server mis-sized its directory
+ * entries and the listing was recovered
+ */
+#define SMB_FIND_INCOMPLETE  0x01
+#define SMB_FIND_RESYNCED    0x02
+BDSM_EXPORT
+unsigned int    smb_session_get_find_flags(smb_session *s);
+
 
 #endif
